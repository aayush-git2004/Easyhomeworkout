---
const {
  title = 'Easy Home Workout',
  description = 'Your fitness journey starts at home.',
  active = '',
  ogImage = 'https://images.unsplash.com/photo-1518611012118-696072aa579a?auto=format&fit=crop&w=1200&h=630&q=85',
} = Astro.props;
const siteUrl = Astro.site ?? new URL('https://freehomeworkout.com');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const nav = [['Workouts','/workouts/'],['Exercises','/exercises/'],['Nutrition','/nutrition/'],['Tools','/tools/']];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} /><meta name="generator" content={Astro.generator} />
<link rel="canonical" href={canonicalUrl} />
<meta property="og:title" content={`${title} | Easy Home Workout`} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Easy Home Workout" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content="A person stretching during a welcoming home workout" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={`${title} | Easy Home Workout`} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta name="apple-mobile-web-app-title" content="Easy Home Workout" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#246b4b" />
<link rel="preconnect" href="https://images.unsplash.com" />
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){window.dataLayer.push(arguments);}
  gtag('js', new Date());
  window.dataLayer.push({'gtm.start': new Date().getTime(), event: 'gtm.js'});
</script>
<script async src="https://www.googletagmanager.com/gtm.js?id=GTM-PC24PD2H"></script>
<title>{title} | Easy Home Workout</title>
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');
:root{--ink:#1d2925;--muted:#64716a;--green:#246b4b;--lime:#d7f36b;--cream:#f7f8f3;--line:#e4e9e1;--white:#fff;--shadow:0 14px 38px rgba(29,41,37,.08)}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--cream);color:var(--ink);font-family:'DM Sans',sans-serif;line-height:1.6}h1,h2,h3,h4{font-family:Manrope,sans-serif;line-height:1.15;letter-spacing:-.035em;margin:0 0 .7em}h1{font-size:clamp(2.6rem,5.5vw,5.2rem)}h2{font-size:clamp(2rem,4vw,3.3rem)}h3{font-size:1.35rem}p{color:var(--muted);margin:0 0 1rem}a{color:inherit;text-decoration:none}button,input,select{font:inherit}button,a,input,select{outline-offset:3px}a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #99c93d}.wrap{width:min(1160px,calc(100% - 44px));margin:auto}.site-header{height:78px;display:flex;align-items:center;background:rgba(247,248,243,.94);border-bottom:1px solid var(--line);position:sticky;top:0;z-index:20;backdrop-filter:blur(14px)}.nav-row{display:flex;align-items:center;justify-content:space-between;gap:24px}.brand{font:800 1.35rem Manrope,sans-serif;letter-spacing:-.05em;display:flex;gap:10px;align-items:center}.brand-mark{width:34px;height:34px;border-radius:11px;background:var(--green);color:white;display:grid;place-items:center;font-size:19px}.nav-links{display:flex;align-items:center;gap:26px;color:#435149;font-size:.94rem}.nav-links a:hover{color:var(--green)}.nav-cta,.btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;border:0;border-radius:999px;background:var(--green);color:#fff;padding:13px 21px;font-weight:700;cursor:pointer;transition:transform .2s,background .2s}.nav-cta:hover,.btn:hover{background:#164c34;transform:translateY(-2px)}.btn-light{background:white;color:var(--ink);border:1px solid var(--line)}.btn-light:hover{background:#eff4e8;color:var(--green)}.btn-lime{background:var(--lime);color:var(--ink)}.btn-lime:hover{background:#c8e954}.menu-toggle{display:none;background:none;border:0;font-size:1.5rem}.hero{padding:70px 0 82px}.hero-grid{display:grid;grid-template-columns:1.02fr .98fr;align-items:center;gap:55px}.eyebrow{display:inline-flex;align-items:center;gap:9px;text-transform:uppercase;letter-spacing:.12em;font-size:.74rem;font-weight:700;color:var(--green);margin-bottom:19px}.eyebrow:before{content:'';width:22px;height:2px;background:var(--green)}.hero h1 span{color:var(--green)}.hero-copy{font-size:1.12rem;max-width:550px;margin:0 0 27px}.actions{display:flex;flex-wrap:wrap;gap:12px}.hero-visual{position:relative}.hero-photo{height:535px;width:100%;object-fit:cover;border-radius:34px 34px 130px 34px;display:block}.float-card{position:absolute;background:white;padding:15px 18px;border-radius:18px;box-shadow:var(--shadow);font-weight:700}.float-card small{display:block;color:var(--muted);font-weight:400;font-size:.78rem}.float-a{left:-35px;top:45px}.float-b{right:-18px;bottom:38px}.dot{display:inline-block;width:9px;height:9px;background:#a9d751;border-radius:50%;margin-right:7px}.section{padding:82px 0}.section-white{background:#fff}.section-head{display:flex;justify-content:space-between;gap:24px;align-items:end;margin-bottom:34px}.section-head p{max-width:490px;margin:0}.center{text-align:center}.center .section-head{display:block}.center .section-head p{margin:auto}.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.grid-4{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.card{background:white;border:1px solid var(--line);border-radius:23px;overflow:hidden;box-shadow:0 4px 18px rgba(29,41,37,.025)}.card-pad{padding:23px}.card p{font-size:.94rem}.card img{width:100%;height:210px;object-fit:cover;display:block;background:#e9eee4}.feature-card{padding:27px}.icon{width:48px;height:48px;border-radius:15px;background:#eef5e7;display:grid;place-items:center;color:var(--green);font-size:1.35rem;margin-bottom:18px}.pill{display:inline-flex;border-radius:99px;background:#eef5e7;color:var(--green);font-size:.75rem;padding:5px 10px;font-weight:700}.meta{display:flex;gap:13px;flex-wrap:wrap;color:var(--muted);font-size:.82rem;margin:13px 0}.goal-card{position:relative;min-height:310px;overflow:hidden;border-radius:23px;color:white;display:flex;align-items:end;padding:23px;background:#333}.goal-card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .4s}.goal-card:after{content:'';position:absolute;inset:0;background:linear-gradient(0deg,rgba(15,26,20,.84),transparent 75%)}.goal-card:hover img{transform:scale(1.04)}.goal-card div{position:relative;z-index:1}.goal-card p{color:#e5ece5;margin:0}.split{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}.split img{width:100%;height:430px;object-fit:cover;border-radius:30px}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:30px}.step-num{font:800 3rem Manrope;color:#b6d77b;margin-bottom:10px}.banner{background:var(--green);color:#fff;border-radius:30px;padding:48px;display:flex;justify-content:space-between;align-items:center;gap:25px}.banner h2,.banner p{color:white}.banner p{opacity:.8;max-width:540px}.page-hero{padding:58px 0 40px}.page-hero h1{font-size:clamp(2.5rem,5vw,4rem);max-width:850px}.page-hero p{font-size:1.08rem;max-width:690px}.content-section{padding:30px 0 80px}.filterbar,.tool-panel{background:white;padding:20px;border:1px solid var(--line);border-radius:20px;display:flex;gap:12px;flex-wrap:wrap;margin-bottom:24px}.field{display:flex;flex-direction:column;gap:6px;flex:1;min-width:155px}.field label{font-size:.82rem;font-weight:700}.field input,.field select,.inline-input{border:1px solid #d9e1d7;border-radius:11px;background:#fff;padding:11px 12px;color:var(--ink);min-width:0}.workout-card img{height:195px}.workout-card .card-pad{padding:20px}.card-link{color:var(--green);font-weight:700;display:inline-flex;gap:7px;margin-top:5px}.empty{padding:35px;text-align:center;color:var(--muted);background:white;border-radius:18px}.detail-layout{display:grid;grid-template-columns:1.5fr .8fr;gap:28px}.panel{padding:27px;background:white;border:1px solid var(--line);border-radius:22px;margin-bottom:20px}.exercise-row{padding:17px 0;border-bottom:1px solid var(--line)}.exercise-row:last-child{border:0}.exercise-row h3{margin-bottom:5px}.callout{background:#f0f5e9;border-left:4px solid #95bf47;border-radius:10px;padding:15px 18px;color:#435149;margin:18px 0}.tool-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}.tool-panel{display:block;margin:0;padding:24px}.tool-panel h2,.tool-panel h3{font-size:1.35rem;margin-bottom:12px}.form-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.result{font-weight:700;color:var(--green);padding-top:13px;min-height:42px}.water-count{font:800 2rem Manrope;margin:12px 0}.progress-track{height:11px;background:#e8eee4;border-radius:99px;overflow:hidden;margin:14px 0}.progress-track span{display:block;height:100%;background:#8cbd44;border-radius:99px;width:0;transition:width .3s}.challenge-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:10px}.day{background:white;border:1px solid var(--line);border-radius:14px;padding:13px 8px;text-align:center;min-height:100px}.day.done{background:#edf6df;border-color:#b6d77b}.day button{border:0;background:none;color:var(--green);font-weight:700;cursor:pointer;padding:3px}.day small{display:block;color:var(--muted);font-size:.72rem}.week-title{margin:35px 0 14px}.timer{font:800 3.5rem Manrope;text-align:center;padding:12px;color:var(--green)}.footer{background:#1e3028;color:#fff;padding:56px 0 24px}.footer p,.footer a{color:#c7d2cb}.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1.3fr;gap:32px}.footer h3{font-size:1rem;color:#fff}.footer a{display:block;margin:9px 0;font-size:.9rem}.copyright{border-top:1px solid #405149;margin-top:35px;padding-top:18px;font-size:.82rem;color:#aab8af}.nutrition-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}.nutrition-item{padding:22px;background:white;border:1px solid var(--line);border-radius:18px}.checklist{padding-left:20px;color:var(--muted)}.checklist li{padding:5px 0}.notice{font-size:.83rem;color:var(--muted)}
@media(max-width:900px){.nav-links{gap:15px}.hero-grid{gap:35px}.hero-photo{height:440px}.grid-4{grid-template-columns:repeat(2,1fr)}.footer-grid{grid-template-columns:1fr 1fr}.detail-layout{grid-template-columns:1fr}.challenge-grid{grid-template-columns:repeat(5,1fr)}}
@media(max-width:680px){.wrap{width:min(100% - 32px,1160px)}.site-header{height:68px}.menu-toggle{display:block}.nav-cta{display:none}.nav-links{display:none;position:absolute;top:68px;left:0;right:0;padding:16px 22px 22px;background:var(--cream);border-bottom:1px solid var(--line);flex-direction:column;align-items:stretch;gap:0}.nav-links.open{display:flex}.nav-links a{padding:11px 0}.hero{padding:42px 0 58px}.hero-grid,.split{grid-template-columns:1fr}.hero-grid{gap:38px}.hero-photo{height:390px;border-radius:25px 25px 90px 25px}.float-a{left:-8px;top:18px}.float-b{right:-8px;bottom:18px}.section{padding:58px 0}.section-head{display:block}.section-head p{margin-top:10px}.grid-3,.steps,.tool-grid,.nutrition-grid{grid-template-columns:1fr}.grid-4{grid-template-columns:1fr 1fr;gap:12px}.goal-card{min-height:250px}.banner{padding:30px;display:block}.banner .btn{margin-top:10px}.split img{height:320px}.page-hero{padding:40px 0 28px}.content-section{padding-bottom:58px}.challenge-grid{grid-template-columns:repeat(3,1fr);gap:7px}.day{min-height:90px;padding:10px 4px}.footer-grid{grid-template-columns:1fr 1fr}.footer-grid>div:first-child{grid-column:1/-1}.form-grid{grid-template-columns:1fr}.card img{height:185px}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto!important;transition:none!important}}
.brand-mark{display:block;object-fit:contain;flex:0 0 auto;background:transparent;border-radius:0}
@media(max-width:380px){.wrap{width:calc(100% - 28px)}.brand{font-size:1.08rem;gap:7px}.brand-mark{width:31px;height:31px}.nav-row{gap:10px}.grid-4{grid-template-columns:1fr}.goal-card{min-height:220px}.challenge-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.day{overflow-wrap:anywhere}.banner{padding:24px}.actions .btn{flex:1 1 100%}}
</style>
<style is:global>
.footer-grid{grid-template-columns:2fr 1fr 1fr 1fr 1.3fr;gap:28px}
@media(max-width:900px){.footer-grid{grid-template-columns:1fr 1fr}}
</style>
</head>
<body>
<header class="site-header"><div class="wrap nav-row"><a class="brand" href="/" aria-label="Easy Home Workout home"><img class="brand-mark" src="/favicon.svg" alt="" width="36" height="36" />Easy Home Workout</a><button class="menu-toggle" aria-label="Open navigation" aria-expanded="false">&#9776;</button><nav class="nav-links" aria-label="Main navigation">{nav.map(([label,url])=><a href={url} aria-current={active===url?'page':undefined}>{label}</a>)}<a href="/challenge/">30-day challenge</a></nav><a class="nav-cta" href="/workouts/">Start workout <span>&#8599;</span></a></div></header>
<main><slot /></main>
<footer class="footer"><div class="wrap"><div class="footer-grid"><div><a class="brand" href="/"><img class="brand-mark" src="/favicon.svg" alt="" width="36" height="36" />Easy Home Workout</a><p style="margin-top:17px;max-width:330px">Your fitness journey starts at home. Simple guidance, thoughtful workouts, and progress at your own pace.</p></div><div><h3>Explore</h3><a href="/workouts/">Workout plans</a><a href="/exercises/">Exercise library</a><a href="/challenge/">30-day challenge</a></div><div><h3>Learn</h3><a href="/nutrition/">Nutrition guide</a><a href="/tools/">Fitness tools</a><a href="/progress/">My progress</a><a href="/about/">About Easy Home Workout</a><a href="/contact/">Contact us</a></div><div><h3>Legal</h3><a href="/privacy/">Privacy policy</a><a href="/terms/">Terms and conditions</a></div><div><h3>A note on movement</h3><p>Move at a pace that feels right for you. Stop if you feel pain, and seek qualified advice when you need it.</p></div></div><div class="copyright">&middot; {new Date().getFullYear()} Easy Home Workout. Your Fitness Journey Starts at Home.</div></div></footer>
<script is:inline>
const toggle=document.querySelector('.menu-toggle'),nav=document.querySelector('.nav-links');toggle?.addEventListener('click',()=>{const open=nav.classList.toggle('open');toggle.setAttribute('aria-expanded',String(open));toggle.setAttribute('aria-label',open?'Close navigation':'Open navigation')});
document.querySelectorAll('img').forEach(img=>img.addEventListener('error',()=>{img.style.background='#e6eee2';img.removeAttribute('src');img.alt=img.alt+' (image unavailable)'},{once:true}));
</script>
</body></html>

