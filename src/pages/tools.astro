---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Fitness Tools" description="Free BMI and calorie estimates, a water tracker, and a workout rest timer."><section class="page-hero"><div class="wrap"><span class="eyebrow">Helpful estimates and handy tools</span><h1>Your home fitness toolkit.</h1><p>Use these simple tools as general references. Estimates are not medical advice or individualized prescriptions.</p></div></section><section class="content-section"><div class="wrap tool-grid"><section class="tool-panel"><h2>BMI calculator</h2><p>For adults; BMI is a rough screening measure, not a diagnosis or complete health assessment.</p><div class="form-grid"><div class="field"><label for="height">Height (cm)</label><input type="number" id="height" min="100" max="250"/></div><div class="field"><label for="weight">Weight (kg)</label><input type="number" id="weight" min="25" max="350"/></div></div><button id="bmi" class="btn" style="margin-top:13px">Calculate BMI</button><div id="bmi-result" class="result" aria-live="polite"></div></section><section class="tool-panel"><h2>Daily calorie estimate</h2><p>Mifflin&middot;St Jeor resting energy estimate multiplied by an activity factor.</p><div class="form-grid"><div class="field"><label for="age">Age (years)</label><input type="number" id="age" min="18" max="100"/></div><div class="field"><label for="sex">Equation selection</label><select id="sex"><option value="female">Female</option><option value="male">Male</option></select></div><div class="field"><label for="h2">Height (cm)</label><input type="number" id="h2" min="100" max="250"/></div><div class="field"><label for="w2">Weight (kg)</label><input type="number" id="w2" min="25" max="350"/></div><div class="field"><label for="activity">Activity level</label><select id="activity"><option value="1.2">Mostly sedentary</option><option value="1.375">Light activity</option><option value="1.55">Moderate activity</option><option value="1.725">Very active</option></select></div></div><button id="calorie" class="btn" style="margin-top:13px">Estimate energy</button><div id="cal-result" class="result" aria-live="polite"></div><p class="notice">An estimate, not a personalized medical or dietary prescription. Individual needs vary.</p></section><section class="tool-panel"><h2>Water tracker</h2><p>Set a personal target if you already have one. Needs vary; this tracker does not determine what is right for you.</p><label for="target">Your daily target (ml, optional)</label><input class="inline-input" type="number" id="target" min="1" placeholder="Set your own target"/><div class="water-count"><span id="water-count">0</span> ml</div><div class="progress-track"><span id="water-bar"></span></div><button id="add-water" class="btn">Add 250 ml</button> <button id="remove-water" class="btn btn-light">Remove 250 ml</button> <button id="reset-water" class="btn btn-light">Reset today</button><p id="water-msg" class="result" aria-live="polite"></p></section><section class="tool-panel"><h2>Workout rest timer</h2><p>Set a rest interval that suits your session.</p><div class="form-grid"><div class="field"><label for="minutes">Minutes</label><input type="number" id="minutes" min="0" max="99" value="1"/></div><div class="field"><label for="seconds">Seconds</label><input type="number" id="seconds" min="0" max="59" value="0"/></div></div><div class="timer" id="timer">01:00</div><div style="text-align:center"><button class="btn" id="start">Start</button> <button class="btn btn-light" id="pause">Pause</button> <button class="btn btn-light" id="timer-reset">Reset</button></div><p id="timer-msg" class="result" aria-live="polite" style="text-align:center"></p></section></div></section><script is:inline>
document.querySelector('#bmi').onclick=()=>{let h=+document.querySelector('#height').value/100,w=+document.querySelector('#weight').value,r=document.querySelector('#bmi-result');if(!h||!w){r.textContent='Enter a valid height and weight.';return}let v=w/(h*h),c=v<18.5?'below the standard adult range':v<25?'within the standard adult range':v<30?'above the standard adult range':'in the higher adult range';r.textContent=`BMI ${v.toFixed(1)} &middot; ${c}. This is a rough screening measure.`};document.querySelector('#calorie').onclick=()=>{const age=+document.querySelector('#age').value,h=+document.querySelector('#h2').value,w=+document.querySelector('#w2').value,sex=document.querySelector('#sex').value,a=+document.querySelector('#activity').value,r=document.querySelector('#cal-result');if(!age||!h||!w){r.textContent='Complete all fields with valid values.';return}const b=10*w+6.25*h-5*age+(sex==='male'?5:-161);r.textContent=`Estimated ${Math.round(b*a)} kcal/day. Treat this as a broad estimate.`};
const wk='fhw-water',today=new Date().toISOString().slice(0,10);let water=JSON.parse(localStorage.getItem(wk)||'{}');if(water.date!==today)water={date:today,count:0,target:water.target||''};const count=document.querySelector('#water-count'),bar=document.querySelector('#water-bar'),target=document.querySelector('#target');target.value=water.target;function wp(){count.textContent=water.count;water.target=target.value;const t=+target.value;bar.style.width=t?Math.min(100,water.count/t*100)+'%':'0%';document.querySelector('#water-msg').textContent=t&&water.count>=t?'Your personal target is reached.': '';localStorage.setItem(wk,JSON.stringify(water))}target.oninput=wp;document.querySelector('#add-water').onclick=()=>{water.count+=250;wp()};document.querySelector('#remove-water').onclick=()=>{water.count=Math.max(0,water.count-250);wp()};document.querySelector('#reset-water').onclick=()=>{water.count=0;wp()};wp();
let remaining=60,interval=null;const display=document.querySelector('#timer');function show(){display.textContent=String(Math.floor(remaining/60)).padStart(2,'0')+':'+String(remaining%60).padStart(2,'0')}function configured(){remaining=(+document.querySelector('#minutes').value||0)*60+(+document.querySelector('#seconds').value||0);show()}document.querySelector('#start').onclick=()=>{if(interval)return;if(remaining<=0)configured();document.querySelector('#timer-msg').textContent='';interval=setInterval(()=>{remaining--;show();if(remaining<=0){clearInterval(interval);interval=null;document.querySelector('#timer-msg').textContent='Rest interval complete.'}},1000)};document.querySelector('#pause').onclick=()=>{clearInterval(interval);interval=null};document.querySelector('#timer-reset').onclick=()=>{clearInterval(interval);interval=null;configured();document.querySelector('#timer-msg').textContent=''};['minutes','seconds'].forEach(id=>document.querySelector('#'+id).onchange=()=>{if(!interval)configured()});configured();
</script></Layout>

