---
import Layout from '../layouts/Layout.astro';
const days=[['Easy walk or march','10 min'],['Chair squats + wall push-ups','10 min'],['Gentle mobility','8 min'],['Easy walk or march','12 min'],['Glute bridges + bird dogs','10 min'],['Rest or easy stretching','5 min'],['Choose a favorite movement','10 min'],['Easy walk','12 min'],['Squats + incline push-ups','12 min'],['Mobility and balance','10 min'],['Rest day','Rest'],['March + side steps','12 min'],['Glute bridges + calf raises','12 min'],['Gentle stretch','8 min'],['Full-body starter circuit','15 min'],['Easy walk or march','15 min'],['Squats + wall push-ups','15 min'],['Mobility and breathing','10 min'],['Rest day','Rest'],['Step-back taps + bridges','15 min'],['Choose a favorite activity','15 min'],['Easy walk or march','18 min'],['Full-body circuit at your pace','15 min'],['Recovery stretch','10 min'],['Rest day','Rest'],['Walk or low-impact cardio','20 min'],['Strength circuit at your pace','18 min'],['Mobility and balance','12 min'],['Choose a movement you enjoy','20 min'],['Celebrate with an easy favorite','10 min']];
---
<Layout title="30-Day Home Fitness Challenge" description="A flexible beginner fitness challenge with workouts, mobility, and recovery days."><section class="page-hero"><div class="wrap"><span class="eyebrow">Small steps add up</span><h1>30-day beginner challenge</h1><p>Build a movement habit with short, flexible activities. Rest days are included, and you can adapt or repeat days to suit your needs.</p></div></section><section class="content-section"><div class="wrap"><div class="panel"><div style="display:flex;justify-content:space-between;gap:20px;align-items:center;flex-wrap:wrap"><div><h2>Your progress</h2><p id="summary">0 of 30 days complete</p></div><button id="reset" class="btn btn-light">Reset challenge</button></div><div class="progress-track"><span id="bar"></span></div><strong id="percent">0%</strong><p id="done" class="result" aria-live="polite"></p></div>{[1,2,3,4].map((week,wi)=><section><h2 class="week-title">Week {week}: {['Build the Habit','Develop Consistency','Improve Strength','Build Confidence'][wi]}</h2><div class="challenge-grid">{days.slice(wi*7,wi===3?30:wi*7+7).map(([activity,time],di)=>{const day=wi*7+di+1;return <article class="day" data-day={day}><strong>Day {day}</strong><small>{activity}</small><small>{time}</small><button aria-label={`Mark day ${day} complete`}>Mark done</button></article>})}</div></section>)}</div></section><script is:inline>const key='fhw-challenge';let complete=new Set(JSON.parse(localStorage.getItem(key)||'[]'));function paint(){document.querySelectorAll('.day').forEach(d=>{const yes=complete.has(Number(d.dataset.day));d.classList.toggle('done',yes);d.querySelector('button').textContent=yes?'Completed':'Mark done'});const n=complete.size,p=Math.round(n/30*100);document.querySelector('#summary').textContent=`${n} of 30 days complete`;document.querySelector('#percent').textContent=p+'%';document.querySelector('#bar').style.width=p+'%';document.querySelector('#done').textContent=n===30?'Challenge complete! You showed up for yourself, one day at a time.':''}document.querySelectorAll('.day button').forEach(b=>b.addEventListener('click',()=>{let n=Number(b.closest('.day').dataset.day);complete.has(n)?complete.delete(n):complete.add(n);localStorage.setItem(key,JSON.stringify([...complete]));paint()}));document.querySelector('#reset').addEventListener('click',()=>{if(confirm('Reset all challenge progress on this device?')){complete.clear();localStorage.removeItem(key);paint()}});paint();</script></Layout>

