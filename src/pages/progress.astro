---
import Layout from '../layouts/Layout.astro';
---
<Layout title="My Progress" description="Review locally saved workouts, challenge completion, and weekly activity."><section class="page-hero"><div class="wrap"><span class="eyebrow">Your own pace</span><h1>Progress you can feel good about.</h1><p>Your activity stays in this browser. Nothing is sent to an account or server.</p></div></section><section class="content-section"><div class="wrap"><div class="grid-3"><article class="panel"><span class="pill">Workout sessions</span><div class="water-count" id="total">0</div><p>Completed workouts recorded here</p></article><article class="panel"><span class="pill">Challenge</span><div class="water-count" id="challenge-count">0 / 30</div><div class="progress-track"><span id="challenge-bar"></span></div><a class="card-link" href="/challenge/">Continue challenge &#8599;</a></article><article class="panel"><span class="pill">This week</span><div class="water-count" id="week">0</div><p>Workout sessions in the last 7 days</p></article></div><div class="panel" style="margin-top:20px"><div style="display:flex;justify-content:space-between;align-items:center;gap:15px;flex-wrap:wrap"><div><h2>Workout history</h2><p>Your completed sessions appear here.</p></div><button id="reset" class="btn btn-light">Reset all progress</button></div><div id="history"></div></div><div class="panel"><h2>Daily activity</h2><p id="daily">No challenge activities completed yet.</p></div></div></section><script is:inline>function render(){let workouts=JSON.parse(localStorage.getItem('fhw-workouts')||'[]'),challenge=JSON.parse(localStorage.getItem('fhw-challenge')||'[]');document.querySelector('#total').textContent=workouts.length;document.querySelector('#challenge-count').textContent=`${challenge.length} / 30`;document.querySelector('#challenge-bar').style.width=(challenge.length/30*100)+'%';const ago=Date.now()-7*86400000;document.querySelector('#week').textContent=workouts.filter(w=>new Date(w.date).getTime()>=ago).length;document.querySelector('#history').innerHTML=workouts.length?'<ul class="checklist">'+workouts.slice().reverse().map(w=>`<li>${w.title} &middot; ${new Date(w.date).toLocaleDateString()}</li>`).join('')+'</ul>':'<p class="empty">No workouts saved yet. Complete a workout and it will show up here.</p>';document.querySelector('#daily').textContent=challenge.length?`You've marked ${challenge.length} challenge ${challenge.length===1?'day':'days'} complete. Open the challenge to see each day.`:'No challenge activities completed yet.'}document.querySelector('#reset').onclick=()=>{if(confirm('Clear your workout history and challenge progress from this browser?')){localStorage.removeItem('fhw-workouts');localStorage.removeItem('fhw-challenge');render()}};render();</script></Layout>

