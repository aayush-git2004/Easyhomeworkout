---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page Not Found" description="This page could not be found. Return to Easy Home Workout to explore home workout plans and exercises.">
  <section class="page-hero" style="min-height:65vh;display:grid;align-items:center;text-align:center">
    <div class="wrap">
      <span class="eyebrow">404 · Page not found</span>
      <h1>Looks like this page took a different route.</h1>
      <p style="max-width:600px;margin:0 auto 24px">The link may be out of date, or the page may have moved. You can get back to your home workout journey from here.</p>
      <div class="actions" style="justify-content:center">
        <a class="btn" href="/">Go to Easy Home Workout home</a>
        <a class="btn btn-light" href="/workouts/">Explore workout plans</a>
      </div>
    </div>
  </section>
</Layout>
