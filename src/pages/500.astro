---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Something Went Wrong" description="Easy Home Workout could not load this page. Please try again or return to the home page.">
  <section class="page-hero" style="min-height:65vh;display:grid;align-items:center;text-align:center">
    <div class="wrap">
      <span class="eyebrow">500 · Something went wrong</span>
      <h1>We couldn't load that page.</h1>
      <p style="max-width:600px;margin:0 auto 24px">Please try again in a little while. You can also return home or browse the workout plans while we get things back on track.</p>
      <div class="actions" style="justify-content:center">
        <a class="btn" href="/">Go to Easy Home Workout home</a>
        <a class="btn btn-light" href="/workouts/">Explore workout plans</a>
      </div>
    </div>
  </section>
</Layout>
