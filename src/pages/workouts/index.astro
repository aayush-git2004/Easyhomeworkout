---
import Layout from '../../layouts/Layout.astro';import {workouts} from '../../data/workouts';
---
<Layout title="Workout Plans" description="Six complete home workout plans with beginner, intermediate, and advanced options."><section class="page-hero"><div class="wrap"><span class="eyebrow">Find your rhythm</span><h1>Workouts for the space you're in.</h1><p>Choose from six detailed routines by experience level, time, and equipment. Follow each movement at a pace that suits you.</p></div></section><section class="content-section"><div class="wrap"><div class="filterbar"><div class="field"><label for="level">Difficulty</label><select id="level"><option value="">All levels</option><option>Beginner</option><option>Intermediate</option><option>Advanced</option></select></div><div class="field"><label for="search">Search workouts</label><input id="search" placeholder="Try full body"/></div><button id="clear" class="btn btn-light">Clear filters</button></div><div id="cards" class="grid-3">{workouts.map(w=><article class="card workout-card" data-level={w.level} data-search={`${w.title} ${w.focus} ${w.desc}`.toLowerCase()}><img loading="lazy" src={`https://images.unsplash.com/${w.image}?auto=format&fit=crop&w=700&q=80`} alt={`${w.title} at home`}/><div class="card-pad"><span class="pill">{w.level}</span><h3 style="margin-top:12px">{w.title}</h3><div class="meta"><span>&#9711; {w.duration}</span><span>&#9711; {w.focus}</span><span>Equipment: {w.equipment}</span></div><p>{w.desc}</p><a class="card-link" href={`/workouts/${w.slug}/`}>View workout &#8599;</a></div></article>)}</div><p id="empty" class="empty" hidden>No workouts match those filters. Try a broader search.</p></div></section><script is:inline>const cards=[...document.querySelectorAll('.workout-card')],filter=()=>{const l=document.querySelector('#level').value,q=document.querySelector('#search').value.toLowerCase();let n=0;cards.forEach(c=>{const show=(!l||c.dataset.level===l)&&c.dataset.search.includes(q);c.hidden=!show;if(show)n++});document.querySelector('#empty').hidden=n>0};document.querySelector('#level').addEventListener('change',filter);document.querySelector('#search').addEventListener('input',filter);document.querySelector('#clear').addEventListener('click',()=>{document.querySelector('#level').value='';document.querySelector('#search').value='';filter()});</script></Layout>

