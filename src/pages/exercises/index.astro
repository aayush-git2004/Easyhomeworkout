---
import Layout from '../../layouts/Layout.astro';import {exercises} from '../../data/exercises';
---
<Layout title="Exercise Library" description="Browse 37 home exercises by target area, level, and equipment."><section class="page-hero"><div class="wrap"><span class="eyebrow">Learn the movement</span><h1>Exercise library</h1><p>Find exercises by the area you want to work on. Each guide includes setup, movement steps, level-specific recommendations, rest, and common mistakes.</p></div></section><section class="content-section"><div class="wrap"><div class="filterbar"><div class="field"><label for="q">Exercise name</label><input id="q" placeholder="Search exercises"/></div><div class="field"><label for="muscle">Muscle group</label><select id="muscle"><option value="">All groups</option>{['Chest','Back','Shoulders','Arms','Legs','Glutes','Core','Cardio','Flexibility'].map(x=><option>{x}</option>)}</select></div><div class="field"><label for="difficulty">Difficulty</label><select id="difficulty"><option value="">Any level</option><option>Beginner</option><option>Intermediate</option><option>Advanced</option></select></div><div class="field"><label for="equipment">Equipment</label><select id="equipment"><option value="">Any equipment</option><option value="none">No equipment</option><option value="mat">Mat</option><option value="support">Chair or wall support</option><option value="backpack">Backpack</option></select></div><button id="reset" class="btn btn-light">Clear filters</button></div><div id="exercises" class="grid-3">{exercises.map(e=><article class="card feature-card ex-card" data-name={e.name.toLowerCase()} data-muscle={e.category.toLowerCase()} data-difficulty={e.levels.join('|')} data-equipment={e.equipment.toLowerCase()}><span class="pill">{e.category}</span><h3 style="margin-top:14px">{e.name}</h3><p>Targets: {e.muscles}</p><p>Levels: {e.levels.join(', ')}</p><p>Equipment: {e.equipment}</p><a class="card-link" href={`/exercises/${e.slug}/`}>View instructions &#8599;</a></article>)}</div><p id="empty" class="empty" hidden>No exercises match. Clear a filter to see more.</p></div></section><script is:inline>const rows=[...document.querySelectorAll('.ex-card')];function filter(){const q=document.querySelector('#q').value.toLowerCase(),m=document.querySelector('#muscle').value.toLowerCase(),d=document.querySelector('#difficulty').value,e=document.querySelector('#equipment').value;let n=0;rows.forEach(c=>{const equipment=c.dataset.equipment;let equipmentMatch=!e||(e==='none'?equipment==='none':e==='mat'?equipment.includes('mat'):e==='backpack'?equipment.includes('backpack'):equipment.includes('chair')||equipment.includes('wall'));let ok=c.dataset.name.includes(q)&&(!m||c.dataset.muscle===m)&&(!d||c.dataset.difficulty.split('|').includes(d))&&equipmentMatch;c.hidden=!ok;if(ok)n++});document.querySelector('#empty').hidden=n>0}['q','muscle','difficulty','equipment'].forEach(id=>document.querySelector('#'+id).addEventListener(id==='q'?'input':'change',filter));document.querySelector('#reset').addEventListener('click',()=>{['q','muscle','difficulty','equipment'].forEach(id=>document.querySelector('#'+id).value='');filter()});</script></Layout>

